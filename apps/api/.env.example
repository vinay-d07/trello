NODE_ENV=development
PORT=4000
LOG_LEVEL=info  # set to "debug" to log every SQL query (great for spotting N+1s)

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taskflow?schema=public
REDIS_URL=redis://localhost:6379

# Comma separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Number of reverse proxies in front of the API (for correct client IPs in rate limiting)
TRUST_PROXY=0
